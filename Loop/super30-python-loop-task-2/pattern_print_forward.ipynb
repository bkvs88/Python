   "source": [
    "#Print the following pattern\n",
    "#*\n",
    "#**\n",
    "#***\n",
    "#****\n",
    "#*****"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "395e0ed8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "*\n",
      "**\n",
      "***\n",
      "****\n",
      "*****\n"
     ]
    }
   ],
   "source": [
    "counter=range(1,6) #looping through numbers from 1 to 5 using range function\n",
    "for i in counter: # looping through each number in the range\n",
    "    print(\"*\"*i) # printing a line of asterisks with a length equal to the current number"
   ]
  },
